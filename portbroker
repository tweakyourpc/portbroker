class PortBrokerDashboardHandler(BaseHTTPRequestHandler):
    server_version = f"portbroker/{PORTBROKER_VERSION}"
    sys_version = ""

    def log_message(self, format: str, *args: Any) -> None:
        if getattr(self.server, "access_log", False):
            super().log_message(format, *args)

    def send_json(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload, indent=2, sort_keys=True).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, body: str) -> None:
        encoded = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path == "/":
            self.send_html(render_dashboard_html(self.server.dashboard_name, self.server.dashboard_version))
            return

        if path == "/api/ports":
            try:
                snapshot = build_dashboard_snapshot(self.server.dashboard_name, self.server.dashboard_version)
            except PortBrokerError as exc:
                self.send_json({"error": str(exc)}, status=500)
                return
            self.send_json(snapshot)
            return

        if path == "/whoami":
            self.send_json(
                {
                    "service": self.server.dashboard_name,
                    "version": self.server.dashboard_version,
                    "pid": os.getpid(),
                    "startedAt": self.server.started_at,
                    "host": self.server.bind_host,
                    "port": self.server.bind_port,
                }
            )
            return

        if path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
            return

        self.send_json({"error": f"No route for {path}"}, status=404)


class PortBrokerDashboardServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, host: str, port: int, dashboard_name: str, access_log: bool) -> None:
        super().__init__((host, port), PortBrokerDashboardHandler)
        self.dashboard_name = dashboard_name
        self.dashboard_version = PORTBROKER_VERSION
        self.started_at = now_iso()
        self.bind_host = host
        self.bind_port = port
        self.access_log = access_log


def find_stale_names(entries: dict[str, dict[str, Any]]) -> list[str]:
    if not entries:
        return []

    listener_map = listeners_by_key(entries)
    stale: list[str] = []
    for name, entry in entries.items():
        if entry.get("persistent", False):
            continue
        listeners = listener_map.get((entry["proto"], entry["port"]), [])
        if listeners:
            continue
        stale.append(name)
    return stale


def command_alloc(args: argparse.Namespace) -> int:
    start, end = parse_port_range(args.range)
    meta = parse_meta(args.meta)
    name = args.name
    proto = args.proto
    host = args.host
    persistent_requested = bool(args.persistent)

    with registry_lock():
        entries = load_entries(strict=True)
        now = now_iso()
        if name in entries:
            entry = entries[name]
            if entry["proto"] != proto:
                raise PortBrokerError(
                    f"'{name}' already exists with proto '{entry['proto']}'. "
                    f"Free it first or re-claim with the same proto."
                )
            entry["host"] = host
            entry["cwd"] = os.getcwd()
            entry["updatedAt"] = now
            if args.cmd is not None:
                entry["cmd"] = args.cmd
            entry["meta"] = merge_meta(entry.get("meta", {}), meta)
            entry["persistent"] = bool(entry.get("persistent", False)) or persistent_requested
            entries[name] = entry
            save_registry(entries)
            emit_port(name, entry["port"], args.json)
            return 0

        reserved = {entry["port"] for entry in entries.values() if entry["proto"] == proto}
        listening = {listener.port for listener in listeners_for_proto(proto)}
        for candidate in range(start, end + 1):
            if candidate in reserved or candidate in listening:
                continue
            entries[name] = {
                "name": name,
                "port": candidate,
                "host": host,
                "proto": proto,
                "createdAt": now,
                "updatedAt": now,
                "cwd": os.getcwd(),
                "cmd": args.cmd or "",
                "meta": meta,
                "persistent": persistent_requested,
            }
            save_registry(entries)
            emit_port(name, candidate, args.json)
            return 0

    raise PortBrokerError(f"No free {proto.upper()} ports found in range {start}-{end}.")


def command_claim(args: argparse.Namespace) -> int:
    name = args.name
    port = parse_port(args.port)
    proto = args.proto
    host = args.host
    meta = parse_meta(args.meta)

    with registry_lock():
        entries = load_entries(strict=True)

        for other_name, other in entries.items():
            if other_name == name:
                continue
            if other["proto"] == proto and other["port"] == port:
                raise PortBrokerError(f"Port {port}/{proto} is already reserved by '{other_name}'.")

        listeners = [listener for listener in listeners_for_proto(proto) if listener.port == port]
        if listeners:
            raise PortBrokerError(f"Port {port}/{proto} is already in use by {listener_owner_summary(listeners)}.")

        now = now_iso()
        existing = entries.get(name)
        created = existing["createdAt"] if existing else now
        merged_meta = merge_meta(existing.get("meta", {}) if existing else {}, meta)
        persistent = bool(args.persistent)
        if existing and existing.get("persistent", False):
            persistent = True
        entries[name] = {
            "name": name,
            "port": port,
            "host": host,
            "proto": proto,
            "createdAt": created,
            "updatedAt": now,
            "cwd": os.getcwd(),
            "cmd": args.cmd or (existing.get("cmd", "") if existing else ""),
            "meta": merged_meta,
            "persistent": persistent,
        }
        save_registry(entries)
        emit_port(name, port, args.json)
        return 0


def command_get(args: argparse.Namespace) -> int:
    with registry_lock():
        entries = load_entries(strict=True)
        entry = entries.get(args.name)
        if not entry:
            raise PortBrokerError(f"No reservation found for '{args.name}'.")
        emit_port(args.name, entry["port"], args.json)
        return 0


def command_free(args: argparse.Namespace) -> int:
    with registry_lock():
        entries = load_entries(strict=True)
        if args.name not in entries:
            raise PortBrokerError(f"No reservation found for '{args.name}'.")
        removed = entries.pop(args.name)
        save_registry(entries)
        if args.json:
            print(
                json.dumps(
                    {
                        "freed": True,
                        "name": args.name,
                        "port": removed["port"],
                        "persistent": bool(removed.get("persistent", False)),
                    },
                    sort_keys=True,
                )
            )
        return 0


def command_cleanup(args: argparse.Namespace) -> int:
    with registry_lock():
        entries = load_entries(strict=True)
        stale_names = find_stale_names(entries)
        removed = [
            {
                "name": name,
                "port": entries[name]["port"],
                "proto": entries[name]["proto"],
            }
            for name in stale_names
        ]
        if removed and not args.dry_run:
            for item in removed:
                entries.pop(item["name"], None)
            save_registry(entries)

    if args.json:
        print(
            json.dumps(
                {
                    "dryRun": bool(args.dry_run),
                    "removedCount": len(removed),
                    "removed": removed,
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    action = "Would free" if args.dry_run else "Freed"
    if not removed:
        print("No stale non-persistent reservations found.")
        return 0

    print(f"{action} {len(removed)} stale non-persistent reservation(s):")
    for item in removed:
        print(f"- {item['name']} {item['proto']}/{item['port']}")
    return 0


def command_project_init(args: argparse.Namespace) -> int:
    path = Path(args.package_json).expanduser()
    if path.is_dir():
        path = path / "package.json"

    if not path.exists():
        raise PortBrokerError(f"package.json not found at '{path}'.")

    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise PortBrokerError(f"Cannot read package.json '{path}': {exc}") from exc

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise PortBrokerError(
            f"package.json '{path}' is not valid JSON ({exc.msg} at line {exc.lineno}, column {exc.colno})"
        ) from exc

    if not isinstance(data, dict):
        raise PortBrokerError(f"package.json '{path}' must contain a JSON object.")

    scripts = data.get("scripts")
    if scripts is None:
        scripts = {}
        data["scripts"] = scripts
    if not isinstance(scripts, dict):
        raise PortBrokerError(f"package.json '{path}' field 'scripts' must be an object.")

    start_raw = scripts.get("start")
    if start_raw is None:
        if not args.start_cmd:
            raise PortBrokerError(
                "package.json has no scripts.start. Re-run with --start-cmd '<command to run app>'."
            )
        start_cmd = args.start_cmd.strip()
    else:
        if not isinstance(start_raw, str):
            raise PortBrokerError(f"package.json '{path}' field scripts.start must be a string.")
        start_cmd = start_raw.strip()
        if not start_cmd:
            if not args.start_cmd:
                raise PortBrokerError(
                    "package.json scripts.start is empty. Re-run with --start-cmd '<command to run app>'."
                )
            start_cmd = args.start_cmd.strip()

    if not start_cmd:
        raise PortBrokerError("Start command cannot be empty.")

    base_start, had_prefix = strip_port_env_prefix(start_cmd)
    if not base_start:
        raise PortBrokerError("Unable to determine underlying start command for scripts.start.")

    prefix = port_env_expr(args.name)
    rendered_start = f"{prefix} {base_start}"
    current_start = scripts.get("start", "")
    if not isinstance(current_start, str):
        current_start = str(current_start)
    changed = current_start != rendered_start
    scripts["start"] = rendered_start

    if changed:
        try:
            path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        except OSError as exc:
            raise PortBrokerError(f"Cannot write package.json '{path}': {exc}") from exc

    if args.json:
        print(
            json.dumps(
                {
                    "changed": changed,
                    "name": args.name,
                    "packageJson": str(path),
                    "start": scripts.get("start", ""),
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    if changed:
        print(f"Updated {path}: scripts.start now uses portbroker for '{args.name}'.")
    else:
        print(f"No changes needed in {path}: scripts.start already uses portbroker logic.")
    return 0


def command_install_shell(args: argparse.Namespace) -> int:
    helper_path = Path(args.helper_path).expanduser()
    ensure_parent(helper_path)

    helper_text = shell_helper_content()
    helper_existing = None
    if helper_path.exists():
        if not helper_path.is_file():
            raise PortBrokerError(f"Shell helper path '{helper_path}' is not a file.")
        try:
            helper_existing = helper_path.read_text(encoding="utf-8")
        except OSError as exc:
            raise PortBrokerError(f"Cannot read shell helper '{helper_path}': {exc}") from exc

    helper_changed = helper_existing != helper_text
    if helper_changed:
        try:
            helper_path.write_text(helper_text, encoding="utf-8")
        except OSError as exc:
            raise PortBrokerError(f"Cannot write shell helper '{helper_path}': {exc}") from exc
        try:
            os.chmod(helper_path, 0o755)
        except OSError:
            # Non-fatal on filesystems that do not support chmod semantics.
            pass

    shell_name = args.shell
    if shell_name == "auto":
        detected = Path(os.environ.get("SHELL", "")).name.lower()
        if detected in {"bash", "zsh"}:
            shell_name = detected
        elif args.rc_file:
            shell_name = "custom"
        else:
            raise PortBrokerError(
                "Cannot auto-detect shell from $SHELL. Use --shell bash|zsh or --rc-file PATH."
            )

    if args.rc_file:
        rc_file = Path(args.rc_file).expanduser()
    elif shell_name == "bash":
        rc_file = Path.home() / ".bashrc"
    elif shell_name == "zsh":
        rc_file = Path.home() / ".zshrc"
    else:
        raise PortBrokerError("Unsupported shell target. Use --shell bash|zsh or --rc-file PATH.")

    ensure_parent(rc_file)
    existing = ""
    if rc_file.exists():
        try:
            existing = rc_file.read_text(encoding="utf-8")
        except OSError as exc:
            raise PortBrokerError(f"Cannot read rc file '{rc_file}': {exc}") from exc

    quoted_helper = shlex.quote(str(helper_path))
    start_marker = "# >>> portbroker shell >>>"
    end_marker = "# <<< portbroker shell <<<"
    block = (
        f"{start_marker}\n"
        f"if [ -f {quoted_helper} ]; then\n"
        f"  source {quoted_helper}\n"
        "fi\n"
        f"{end_marker}\n"
    )

    marker_pattern = re.compile(rf"(?ms)^{re.escape(start_marker)}\n.*?^{re.escape(end_marker)}\n?")
    direct_source_pattern = re.compile(
        rf"(?m)^\s*(?:source|\.)\s+[\"']?{re.escape(str(helper_path))}[\"']?\s*$"
    )
    changed = False

    if marker_pattern.search(existing):
        rendered = marker_pattern.sub(block, existing, count=1)
        changed = rendered != existing
        new_content = rendered
    elif direct_source_pattern.search(existing):
        new_content = existing
        changed = False
    else:
        suffix = existing
        if suffix and not suffix.endswith("\n"):
            suffix += "\n"
        if suffix and not suffix.endswith("\n\n"):
            suffix += "\n"
        new_content = suffix + block
        changed = True

    if changed:
        try:
            rc_file.write_text(new_content, encoding="utf-8")
        except OSError as exc:
            raise PortBrokerError(f"Cannot write rc file '{rc_file}': {exc}") from exc

    shell_report = shell_name if shell_name != "custom" else "custom"
    status = {
        "changed": bool(changed or helper_changed),
        "helperPath": str(helper_path),
        "helperWritten": helper_changed,
        "rcFile": str(rc_file),
        "rcUpdated": changed,
        "shell": shell_report,
    }
    if args.json:
        print(json.dumps(status, indent=2, sort_keys=True))
    else:
        action = "Updated" if changed else "Already configured"
        print(f"{action}: {rc_file}")
        print(f"Helper: {helper_path}")
    return 0


def format_table(rows: list[dict[str, Any]], columns: list[tuple[str, str]]) -> str:
    if not rows:
        headers = [heading for _, heading in columns]
        return " ".join(headers) + "\n" + " ".join("-" * len(header) for header in headers)

    widths: dict[str, int] = {}
    for key, heading in columns:
        widths[key] = len(heading)
    for row in rows:
        for key, _ in columns:
            widths[key] = max(widths[key], len(str(row.get(key, ""))))

    def row_to_line(values: dict[str, Any]) -> str:
        return "  ".join(str(values.get(key, "")).ljust(widths[key]) for key, _ in columns)

    header_line = "  ".join(heading.ljust(widths[key]) for key, heading in columns)
    divider = "  ".join("-" * widths[key] for key, _ in columns)
    body = "\n".join(row_to_line(row) for row in rows)
    return "\n".join([header_line, divider, body])


def command_list(args: argparse.Namespace) -> int:
    with registry_lock():
        entries = load_entries(strict=True)
        listener_map = listeners_by_key(entries)
        rows: list[dict[str, Any]] = []
        for name in sorted(entries):
            entry = entries[name]
            listeners = listener_map.get((entry["proto"], entry["port"]), [])
            pid = next((listener.pid for listener in listeners if listener.pid is not None), None)
            rows.append(
                {
                    "name": name,
                    "port": entry["port"],
                    "host": entry["host"],
                    "proto": entry["proto"],
                    "cwd": entry.get("cwd", ""),
                    "createdAt": entry.get("createdAt", ""),
                    "lastSeenPid": "" if pid is None else str(pid),
                    "persistent": bool(entry.get("persistent", False)),
                }
            )

    if args.json:
        print(json.dumps(rows, indent=2, sort_keys=True))
        return 0

    display_rows = [
        {**row, "persistent": "yes" if row["persistent"] else "no"}
        for row in rows
    ]

    columns = [
        ("name", "NAME"),
        ("port", "PORT"),
        ("host", "HOST"),
        ("proto", "PROTO"),
        ("persistent", "PERSISTENT"),
        ("cwd", "CWD"),
        ("createdAt", "CREATED_AT"),
        ("lastSeenPid", "LAST_SEEN_PID"),
    ]
    print(format_table(display_rows, columns))
    return 0


def command_probe(args: argparse.Namespace) -> int:
    port = parse_port(args.port)
    proto = args.proto
    listeners = [listener for listener in listeners_for_proto(proto) if listener.port == port]

    if args.json:
        print(json.dumps([listener.to_dict() for listener in listeners], indent=2, sort_keys=True))
    else:
        if not listeners:
            print(f"No listener found on {proto}/{port}.")
            return 1
        for listener in listeners:
            process = listener.process_name or "unknown"
            pid = str(listener.pid) if listener.pid is not None else "?"
            print(f"{proto} {listener.host}:{listener.port} process={process} pid={pid} via={listener.source}")
    return 0


def command_web(args: argparse.Namespace) -> int:
    requested_port = parse_port(args.port) if args.port is not None else None
    reserved_port = reserve_web_port(
        name=args.name,
        host=args.host,
        requested_port=requested_port,
        range_value=args.range,
        persistent=bool(args.persistent),
    )

    try:
        server = PortBrokerDashboardServer(args.host, reserved_port, args.name, bool(args.verbose))
    except OSError as exc:
        raise PortBrokerError(f"Cannot bind dashboard on {args.host}:{reserved_port}: {exc}") from exc

    print(f"Serving {args.name} on {args.host}:{reserved_port}")
    print(f"Open {dashboard_open_url(args.host, reserved_port)}")
    print("Press Ctrl+C to stop.")

    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()

    return 0


def command_doctor(args: argparse.Namespace) -> int:
    with registry_lock():
        raw = load_registry_raw()
        normalized, issues = normalize_entries(raw.get("entries", {}))
        listener_map = listeners_by_key(normalized) if normalized else {}

    for name, entry in sorted(normalized.items()):
        listeners = listener_map.get((entry["proto"], entry["port"]), [])
        if not listeners:
            continue
        process_names = [listener.process_name.lower() for listener in listeners if listener.process_name]
        if not process_names:
            issues.append(
                {
                    "level": "warning",
                    "name": name,
                    "message": f"Port {entry['port']}/{entry['proto']} is in use but process owner is unknown.",
                }
            )
            continue
        expected = expected_process_name(entry.get("cmd", ""))
        if expected and expected not in process_names:
            found = ", ".join(sorted(set(process_names)))
            issues.append(
                {
                    "level": "error",
                    "name": name,
                    "message": (
                        f"Port {entry['port']}/{entry['proto']} appears to be owned by "
                        f"'{found}', not expected '{expected}'."
                    ),
                }
            )
        elif not expected and not any(name.lower() in proc for proc in process_names):
            found = ", ".join(sorted(set(process_names)))
            issues.append(
                {
                    "level": "warning",
                    "name": name,
                    "message": (
                        f"Port {entry['port']}/{entry['proto']} is active in process '{found}'. "
                        "No --cmd was recorded, so ownership cannot be confirmed."
                    ),
                }
            )

    status = {
        "ok": not any(issue["level"] == "error" for issue in issues),
        "issueCount": len(issues),
        "issues": issues,
    }

    if args.json:
        print(json.dumps(status, indent=2, sort_keys=True))
        return 0 if status["ok"] else 1

    if not issues:
        print("Registry looks healthy.")
        print(f"Entries checked: {len(normalized)}")
        return 0

    for issue in issues:
        level = issue["level"].upper()
        name = issue["name"]
        message = issue["message"]
        print(f"[{level}] {name}: {message}")
        if name != "-":
            print(f"  Suggestion: portbroker free --name {name}")
            print(f"  Or:         portbroker alloc --name {name}")

    return 1 if not status["ok"] else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="portbroker", description="Port reservation broker for homelab services.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    alloc_parser = subparsers.add_parser("alloc", help="Allocate a free port and reserve it for a name.")
    alloc_parser.add_argument("--name", required=True, help="Reservation name.")
    alloc_parser.add_argument("--range", default=DEFAULT_RANGE, help=f"Port range START-END (default: {DEFAULT_RANGE}).")
    alloc_parser.add_argument("--host", default=DEFAULT_HOST, help=f"Host to store in reservation (default: {DEFAULT_HOST}).")
    alloc_parser.add_argument("--proto", default=DEFAULT_PROTO, choices=sorted(SUPPORTED_PROTOS), help="Protocol.")
    alloc_parser.add_argument("-p", "--persistent", action="store_true", help="Mark reservation as persistent.")
    alloc_parser.add_argument("--meta", action="append", nargs="+", metavar="key=value", help="Metadata key=value.")
    alloc_parser.add_argument("--cmd", help="Optional command to store with the reservation.")
    alloc_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    alloc_parser.set_defaults(func=command_alloc)

    claim_parser = subparsers.add_parser("claim", help="Reserve an explicit port for a name.")
    claim_parser.add_argument("--name", required=True, help="Reservation name.")
    claim_parser.add_argument("--port", required=True, help="Port to claim.")
    claim_parser.add_argument("--host", default=DEFAULT_HOST, help=f"Host to store in reservation (default: {DEFAULT_HOST}).")
    claim_parser.add_argument("--proto", default=DEFAULT_PROTO, choices=sorted(SUPPORTED_PROTOS), help="Protocol.")
    claim_parser.add_argument("-p", "--persistent", action="store_true", help="Mark reservation as persistent.")
    claim_parser.add_argument("--meta", action="append", nargs="+", metavar="key=value", help="Metadata key=value.")
    claim_parser.add_argument("--cmd", help="Optional command to store with the reservation.")
    claim_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    claim_parser.set_defaults(func=command_claim)

    get_parser = subparsers.add_parser("get", help="Get an existing reservation by name.")
    get_parser.add_argument("--name", required=True, help="Reservation name.")
    get_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    get_parser.set_defaults(func=command_get)

    free_parser = subparsers.add_parser("free", help="Free an existing reservation.")
    free_parser.add_argument("--name", required=True, help="Reservation name.")
    free_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    free_parser.set_defaults(func=command_free)

    list_parser = subparsers.add_parser("list", help="List reservations.")
    list_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    list_parser.set_defaults(func=command_list)

    cleanup_parser = subparsers.add_parser("cleanup", help="Free stale non-persistent reservations.")
    cleanup_parser.add_argument("--dry-run", action="store_true", help="Show what would be freed.")
    cleanup_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    cleanup_parser.set_defaults(func=command_cleanup)

    project_init_parser = subparsers.add_parser(
        "project-init",
        help="Patch package.json so npm start derives PORT from portbroker.",
    )
    project_init_parser.add_argument("--name", required=True, help="Reservation name to embed in npm start.")
    project_init_parser.add_argument(
        "--package-json",
        default="package.json",
        help="Path to package.json (or project directory containing package.json).",
    )
    project_init_parser.add_argument(
        "--start-cmd",
        help="Fallback start command if scripts.start is missing/empty.",
    )
    project_init_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    project_init_parser.set_defaults(func=command_project_init)

    install_shell_parser = subparsers.add_parser(
        "install-shell",
        help="Install shell helper (dev function) into bash/zsh rc files.",
    )
    install_shell_parser.add_argument(
        "--shell",
        choices=["auto", "bash", "zsh"],
        default="auto",
        help="Target shell (default: auto-detect from $SHELL).",
    )
    install_shell_parser.add_argument(
        "--rc-file",
        help="Override rc file path (for custom shell setup or testing).",
    )
    install_shell_parser.add_argument(
        "--helper-path",
        default=str(DEFAULT_SHELL_HELPER),
        help=f"Destination path for installed shell helper script (default: {DEFAULT_SHELL_HELPER}).",
    )
    install_shell_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    install_shell_parser.set_defaults(func=command_install_shell)

    web_parser = subparsers.add_parser(
        "web",
        help="Run a live dashboard for portbroker reservations.",
    )
    web_parser.add_argument(
        "--name",
        default=DEFAULT_WEB_NAME,
        help=f"Reservation name for the dashboard service (default: {DEFAULT_WEB_NAME}).",
    )
    web_parser.add_argument(
        "--host",
        default=DEFAULT_HOST,
        help=f"Host to bind and store in the reservation (default: {DEFAULT_HOST}).",
    )
    web_parser.add_argument(
        "--port",
        help="Explicit port to bind. If omitted, reuse the reserved port or allocate one from --range.",
    )
    web_parser.add_argument(
        "--range",
        default=DEFAULT_RANGE,
        help=f"Port range START-END used when auto-allocating (default: {DEFAULT_RANGE}).",
    )
    web_parser.add_argument("-p", "--persistent", action="store_true", help="Keep the dashboard reservation persistent.")
    web_parser.add_argument("--verbose", action="store_true", help="Enable access logs for dashboard requests.")
    web_parser.set_defaults(func=command_web)

    doctor_parser = subparsers.add_parser("doctor", help="Check registry integrity and potential drift.")
    doctor_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    doctor_parser.set_defaults(func=command_doctor)

    probe_parser = subparsers.add_parser("probe", help="Inspect which process is listening on a port.")
    probe_parser.add_argument("--port", required=True, help="Port to inspect.")
    probe_parser.add_argument("--proto", default=DEFAULT_PROTO, choices=sorted(SUPPORTED_PROTOS), help="Protocol.")
    probe_parser.add_argument("--json", action="store_true", help="Print JSON output.")
    probe_parser.set_defaults(func=command_probe)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        return int(args.func(args))
    except PortBrokerError as exc:
        print(f"portbroker: error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("portbroker: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
