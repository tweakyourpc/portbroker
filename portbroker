PORTBROKER_VERSION = "1.1.0"
DEFAULT_RANGE = "8700-8999"
DEFAULT_HOST = "0.0.0.0"
DEFAULT_PROTO = "tcp"
SUPPORTED_PROTOS = {"tcp", "udp"}
DEFAULT_SHELL_HELPER = Path.home() / ".config" / "portbroker" / "portbroker-shell.sh"
DEFAULT_WEB_NAME = "portbroker-dashboard"
DASHBOARD_REFRESH_MS = 5000
WHOAMI_TIMEOUT_SECONDS = 0.35


class PortBrokerError(Exception):
    pass


@dataclass
class Listener:
    proto: str
    host: str
    port: int
    process_name: str | None
    pid: int | None
    raw: str
    source: str

    def to_dict(self) -> dict[str, Any]:
        return {
            "proto": self.proto,
            "host": self.host,
            "port": self.port,
            "process": self.process_name,
            "pid": self.pid,
            "source": self.source,
            "raw": self.raw,
        }


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def config_dir() -> Path:
    # Default registry path is ~/.config/portbroker/ports.json.
    # Optional override exists for restricted environments.
    explicit = os.environ.get("PORTBROKER_CONFIG_DIR")
    if explicit:
        return Path(explicit).expanduser()

    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg).expanduser() / "portbroker"

    return Path.home() / ".config" / "portbroker"


def registry_path() -> Path:
    explicit = os.environ.get("PORTBROKER_REGISTRY")
    if explicit:
        return Path(explicit).expanduser()
    return config_dir() / "ports.json"


def lock_path() -> Path:
    explicit = os.environ.get("PORTBROKER_LOCK")
    if explicit:
        return Path(explicit).expanduser()
    return config_dir() / "ports.lock"


def ensure_parent(path: Path) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise PortBrokerError(f"Cannot create directory '{path.parent}': {exc}") from exc


@contextmanager
def registry_lock() -> Any:
    lock = lock_path()
    ensure_parent(lock)
    try:
        with open(lock, "a+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    except OSError as exc:
        raise PortBrokerError(f"Cannot open lock file '{lock}': {exc}") from exc


def load_registry_raw() -> dict[str, Any]:
    path = registry_path()
    if not path.exists():
        return {"version": 1, "entries": {}}

    try:
        content = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise PortBrokerError(f"Cannot read registry '{path}': {exc}") from exc

    if not content.strip():
        return {"version": 1, "entries": {}}

    try:
        data = json.loads(content)
    except json.JSONDecodeError as exc:
        raise PortBrokerError(
            f"Registry '{path}' is not valid JSON ({exc.msg} at line {exc.lineno}, column {exc.colno})"
        ) from exc

    if not isinstance(data, dict):
        raise PortBrokerError(f"Registry '{path}' must contain a JSON object")

    if "entries" not in data:
        # Backward-compatible read for a bare name->entry dictionary.
        if all(isinstance(value, dict) for value in data.values()):
            data = {"version": 1, "entries": data}
        else:
            raise PortBrokerError(f"Registry '{path}' is missing the 'entries' object")

    entries = data.get("entries")
    if not isinstance(entries, dict):
        raise PortBrokerError(f"Registry '{path}' field 'entries' must be a JSON object")

    return {"version": int(data.get("version", 1)), "entries": entries}


def save_registry(entries: dict[str, dict[str, Any]]) -> None:
    path = registry_path()
    ensure_parent(path)
    payload = {"version": 1, "entries": entries}

    try:
        fd, tmp_path = tempfile.mkstemp(prefix="ports.", suffix=".tmp", dir=str(path.parent))
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp_path, path)
    except OSError as exc:
        raise PortBrokerError(f"Cannot write registry '{path}': {exc}") from exc


def parse_port_range(value: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+)-(\d+)", value)
    if not match:
        raise PortBrokerError(f"Invalid range '{value}'. Expected format START-END (e.g., 8700-8999).")
    start = int(match.group(1))
    end = int(match.group(2))
    if start < 1 or end > 65535 or start > end:
        raise PortBrokerError(f"Invalid range '{value}'. Ports must be between 1 and 65535 and START <= END.")
    return start, end


def parse_port(value: Any) -> int:
    try:
        port = int(value)
    except (TypeError, ValueError) as exc:
        raise PortBrokerError(f"Invalid port '{value}'.") from exc
    if port < 1 or port > 65535:
        raise PortBrokerError(f"Invalid port '{value}'. Port must be between 1 and 65535.")
    return port


def flatten_meta(meta_values: list[list[str]] | None) -> list[str]:
    if not meta_values:
        return []
    flattened: list[str] = []
    for chunk in meta_values:
        flattened.extend(chunk)
    return flattened


def parse_meta(meta_values: list[list[str]] | None) -> dict[str, str]:
    result: dict[str, str] = {}
    for item in flatten_meta(meta_values):
        if "=" not in item:
            raise PortBrokerError(f"Invalid --meta value '{item}'. Expected key=value.")
        key, value = item.split("=", 1)
        key = key.strip()
        if not key:
            raise PortBrokerError(f"Invalid --meta value '{item}'. Meta keys cannot be empty.")
        result[key] = value
    return result


def parse_bool(value: Any, *, default: bool = False) -> bool:
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        if value in {0, 1}:
            return bool(value)
        raise ValueError
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "y", "on"}:
            return True
        if normalized in {"0", "false", "no", "n", "off", ""}:
            return False
        raise ValueError
    raise ValueError


def parse_endpoint(endpoint: str) -> tuple[str, int] | None:
    value = endpoint.strip()
    if not value:
        return None

    if value.startswith("["):
        idx = value.rfind("]:")
        if idx < 0:
            return None
        host = value[1:idx]
        port_text = value[idx + 2 :]
    else:
        if ":" not in value:
            return None
        host, port_text = value.rsplit(":", 1)

    if not port_text.isdigit():
        return None

    return host, int(port_text)


def parse_ss_processes(field: str) -> list[tuple[str | None, int | None]]:
    if not field:
        return []

    matches = list(re.finditer(r'"([^"]+)"(?:,pid=(\d+))?', field))
    processes: list[tuple[str | None, int | None]] = []
    for match in matches:
        process = match.group(1)
        pid_text = match.group(2)
        pid = int(pid_text) if pid_text else None
        processes.append((process, pid))
    return processes


def listeners_from_ss(proto: str) -> list[Listener]:
    cmd = ["ss", "-H", "-l", "-n", "-p", "-t" if proto == "tcp" else "-u"]
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)

    if proc.returncode != 0 and not proc.stdout.strip():
        detail = proc.stderr.strip() or f"exit code {proc.returncode}"
        raise PortBrokerError(f"`ss` failed: {detail}")

    listeners: list[Listener] = []
    for raw_line in proc.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        parts = line.split(None, 5)
        if len(parts) < 5:
            continue
        endpoint = parse_endpoint(parts[3])
        if endpoint is None:
            continue
        host, port = endpoint
        process_field = parts[5] if len(parts) >= 6 else ""
        processes = parse_ss_processes(process_field)
        if processes:
            for process_name, pid in processes:
                listeners.append(
                    Listener(
                        proto=proto,
                        host=host,
                        port=port,
                        process_name=process_name,
                        pid=pid,
                        raw=line,
                        source="ss",
                    )
                )
        else:
            listeners.append(
                Listener(
                    proto=proto,
                    host=host,
                    port=port,
                    process_name=None,
                    pid=None,
                    raw=line,
                    source="ss",
                )
            )
    return listeners


def listeners_from_lsof_tcp() -> list[Listener]:
    cmd = ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"]
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)

    if proc.returncode not in {0, 1}:
        detail = proc.stderr.strip() or f"exit code {proc.returncode}"
        raise PortBrokerError(f"`lsof` failed: {detail}")

    listeners: list[Listener] = []
    lines = proc.stdout.splitlines()
    for line in lines[1:]:
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        command = parts[0]
        pid_text = parts[1]
        pid = int(pid_text) if pid_text.isdigit() else None
        name_field = parts[8]
        match = re.search(r"(.+):(\d+)\s+\(LISTEN\)$", name_field)
        if not match:
            continue
        host = match.group(1)
        if host.startswith("[") and host.endswith("]"):
            host = host[1:-1]
        port = int(match.group(2))
        listeners.append(
            Listener(
                proto="tcp",
                host=host,
                port=port,
                process_name=command,
                pid=pid,
                raw=line,
                source="lsof",
            )
        )
    return listeners


def listeners_for_proto(proto: str) -> list[Listener]:
    if proto not in SUPPORTED_PROTOS:
        raise PortBrokerError(f"Unsupported protocol '{proto}'. Expected one of: {', '.join(sorted(SUPPORTED_PROTOS))}.")

    ss_path = shutil.which("ss")
    if ss_path:
        try:
            return listeners_from_ss(proto)
        except PortBrokerError:
            if proto == "tcp" and shutil.which("lsof"):
                return listeners_from_lsof_tcp()
            raise

    if proto == "tcp" and shutil.which("lsof"):
        return listeners_from_lsof_tcp()

    if proto == "tcp":
        raise PortBrokerError(
            "Cannot inspect port usage: `ss` is unavailable and fallback `lsof -iTCP -sTCP:LISTEN` is unavailable."
        )
    raise PortBrokerError("Cannot inspect UDP listeners without `ss`.")


def listeners_by_key(entries: dict[str, dict[str, Any]]) -> dict[tuple[str, int], list[Listener]]:
    mapping: dict[tuple[str, int], list[Listener]] = {}
    protos = sorted({entry["proto"] for entry in entries.values() if "proto" in entry})
    for proto in protos:
        for listener in listeners_for_proto(proto):
            mapping.setdefault((listener.proto, listener.port), []).append(listener)
    return mapping


def normalize_entries(raw_entries: Any) -> tuple[dict[str, dict[str, Any]], list[dict[str, str]]]:
    issues: list[dict[str, str]] = []
    normalized: dict[str, dict[str, Any]] = {}

    if not isinstance(raw_entries, dict):
        issues.append({"level": "error", "name": "-", "message": "Registry 'entries' is not an object."})
        return normalized, issues

    seen_proto_port: dict[tuple[str, int], str] = {}

    for key, value in raw_entries.items():
        name = str(key)
        if not isinstance(value, dict):
            issues.append({"level": "error", "name": name, "message": "Entry must be an object."})
            continue

        entry_name = str(value.get("name", key))
        if entry_name != name:
            issues.append(
                {
                    "level": "warning",
                    "name": name,
                    "message": f"Entry name field '{entry_name}' does not match key '{name}'.",
                }
            )

        try:
            port = parse_port(value.get("port"))
        except PortBrokerError as exc:
            issues.append({"level": "error", "name": name, "message": str(exc)})
            continue

        host = str(value.get("host", DEFAULT_HOST))
        proto = str(value.get("proto", DEFAULT_PROTO)).lower()
        if proto not in SUPPORTED_PROTOS:
            issues.append(
                {
                    "level": "error",
                    "name": name,
                    "message": f"Unsupported proto '{proto}'. Expected tcp or udp.",
                }
            )
            continue

        created_at = str(value.get("createdAt", ""))
        updated_at = str(value.get("updatedAt", ""))
        cwd = str(value.get("cwd", ""))
        cmd = value.get("cmd", "")
        if cmd is None:
            cmd = ""
        if not isinstance(cmd, str):
            cmd = str(cmd)
        meta = value.get("meta", {})
        if not isinstance(meta, dict):
            issues.append({"level": "warning", "name": name, "message": "Meta is not an object; resetting to {}."})
            meta = {}
        try:
            persistent = parse_bool(value.get("persistent", False), default=False)
        except ValueError:
            issues.append(
                {"level": "warning", "name": name, "message": "Persistent is invalid; resetting to false."}
            )
            persistent = False

        dedupe_key = (proto, port)
        prior = seen_proto_port.get(dedupe_key)
        if prior and prior != name:
            issues.append(
                {
                    "level": "error",
                    "name": name,
                    "message": f"Duplicate reservation for {proto}/{port}. Already reserved by '{prior}'.",
                }
            )
            continue
        seen_proto_port[dedupe_key] = name

        normalized[name] = {
            "name": name,
            "port": port,
            "host": host,
            "proto": proto,
            "createdAt": created_at,
            "updatedAt": updated_at,
            "cwd": cwd,
            "cmd": cmd,
            "meta": meta,
            "persistent": persistent,
        }

    return normalized, issues


def load_entries(strict: bool = True) -> dict[str, dict[str, Any]]:
    raw = load_registry_raw()
    normalized, issues = normalize_entries(raw.get("entries", {}))
    if strict and any(issue["level"] == "error" for issue in issues):
        first = next(issue for issue in issues if issue["level"] == "error")
        raise PortBrokerError(
            f"Registry has invalid entries ({first['name']}: {first['message']}). "
            "Run `portbroker doctor` for details."
        )
    return normalized


def emit_port(name: str, port: int, as_json: bool) -> None:
    if as_json:
        print(json.dumps({"name": name, "port": port}, sort_keys=True))
    else:
        print(port)


def merge_meta(current: dict[str, str], incoming: dict[str, str]) -> dict[str, str]:
    merged = dict(current)
    merged.update(incoming)
    return merged


def port_env_expr(name: str) -> str:
    quoted = shlex.quote(name)
    return (
        f"PORT=$(portbroker get --name {quoted} 2>/dev/null "
        f"|| portbroker alloc --name {quoted} --persistent)"
    )


def shell_helper_content() -> str:
    return """#!/usr/bin/env bash

# Source this file from bash or zsh to use the `dev` helper.
# Example:
#   source ~/.config/portbroker/portbroker-shell.sh
#   dev my-app
_portbroker_bin() {
  if [ -n "${PORTBROKER_BIN:-}" ]; then
    printf '%s\\n' "$PORTBROKER_BIN"
    return 0
  fi

  if command -v portbroker >/dev/null 2>&1; then
    printf '%s\\n' "portbroker"
    return 0
  fi

  echo "portbroker not found in PATH." >&2
  return 127
}

dev() {
  if [ "$#" -ne 1 ]; then
    echo "usage: dev <app-name>" >&2
    return 2
  fi

  local app port broker
  app="$1"
  if ! broker="$(_portbroker_bin)"; then
    return $?
  fi

  # Keep disposable reservations tidy without blocking startup.
  ("$broker" cleanup >/dev/null 2>&1 &) >/dev/null 2>&1

  if ! port="$("$broker" alloc --name "$app" --persistent)"; then
    return $?
  fi

  export PORT="$port"
  npm start
}
"""


def strip_port_env_prefix(cmd: str) -> tuple[str, bool]:
    match = re.match(
        r"^PORT=\$\([^)]*portbroker get --name[^)]*portbroker alloc --name[^)]*\)\s+(.*)$",
        cmd.strip(),
        flags=re.DOTALL,
    )
    if not match:
        return cmd, False
    return match.group(1).strip(), True


def expected_process_name(cmd: str) -> str | None:
    if not cmd.strip():
        return None
    try:
        parts = shlex.split(cmd)
    except ValueError:
        parts = cmd.strip().split()
    if not parts:
        return None
    return Path(parts[0]).name.lower()


def listener_owner_summary(listeners: list[Listener]) -> str:
    details = ", ".join(
        sorted(
            {
                f"{listener.process_name or 'unknown'}"
                + (f"(pid={listener.pid})" if listener.pid is not None else "")
                for listener in listeners
            }
        )
    )
    return details or "another process"


def safe_listeners_by_key(entries: dict[str, dict[str, Any]]) -> tuple[dict[tuple[str, int], list[Listener]], str | None]:
    if not entries:
        return {}, None
    try:
        return listeners_by_key(entries), None
    except PortBrokerError as exc:
        return {}, str(exc)


def build_dashboard_snapshot(service_name: str, version: str) -> dict[str, Any]:
    with registry_lock():
        entries = load_entries(strict=True)
        listener_map, listener_error = safe_listeners_by_key(entries)

    rows: list[dict[str, Any]] = []
    active_count = 0
    persistent_count = 0
    inactive_count = 0
    unknown_count = 0

    for name in sorted(entries):
        entry = entries[name]
        listeners = listener_map.get((entry["proto"], entry["port"]), [])
        if listener_error:
            status = "unknown"
            active: bool | None = None
            unknown_count += 1
        elif listeners:
            status = "active"
            active = True
            active_count += 1
        else:
            status = "reserved"
            active = False
            inactive_count += 1

        if entry.get("persistent", False):
            persistent_count += 1

        last_seen_pid = next((listener.pid for listener in listeners if listener.pid is not None), None)
        rows.append(
            {
                "name": name,
                "port": entry["port"],
                "host": entry["host"],
                "proto": entry["proto"],
                "status": status,
                "active": active,
                "persistent": bool(entry.get("persistent", False)),
                "cwd": entry.get("cwd", ""),
                "cmd": entry.get("cmd", ""),
                "createdAt": entry.get("createdAt", ""),
                "updatedAt": entry.get("updatedAt", ""),
                "lastSeenPid": last_seen_pid,
                "listenerCount": len(listeners),
                "listeners": sorted(
                    {
                        f"{listener.process_name or 'unknown'}"
                        + (f"(pid={listener.pid})" if listener.pid is not None else "")
                        for listener in listeners
                    }
                ),
                "meta": entry.get("meta", {}),
            }
        )

    return {
        "service": service_name,
        "version": version,
        "checkedAt": now_iso(),
        "registryPath": str(registry_path()),
        "listenerError": listener_error,
        "summary": {
            "total": len(rows),
            "active": active_count,
            "reserved": inactive_count,
            "persistent": persistent_count,
            "unknown": unknown_count,
        },
        "ports": rows,
    }


def whoami_probe_url(host: str, port: int) -> str:
    probe_host = host or "127.0.0.1"
    if probe_host in {"0.0.0.0", "::", "*"}:
        probe_host = "127.0.0.1"
    if ":" in probe_host and not probe_host.startswith("["):
        probe_host = f"[{probe_host}]"
    return f"http://{probe_host}:{port}/whoami"


def fetch_dashboard_whoami(host: str, port: int) -> dict[str, Any] | None:
    url = whoami_probe_url(host, port)
    try:
        with urlopen(url, timeout=WHOAMI_TIMEOUT_SECONDS) as response:
            if response.status != 200:
                return None
            data = json.loads(response.read().decode("utf-8"))
    except (OSError, TimeoutError, URLError, ValueError, json.JSONDecodeError):
        return None

    if not isinstance(data, dict):
        return None
    return data


def find_free_port(
    entries: dict[str, dict[str, Any]],
    proto: str,
    port_range: tuple[int, int],
    *,
    exclude_names: set[str] | None = None,
) -> int:
    start, end = port_range
    excluded = exclude_names or set()
    reserved = {
        entry["port"]
        for name, entry in entries.items()
        if name not in excluded and entry["proto"] == proto
    }
    listening = {listener.port for listener in listeners_for_proto(proto)}
    for candidate in range(start, end + 1):
        if candidate in reserved or candidate in listening:
            continue
        return candidate
    raise PortBrokerError(f"No free {proto.upper()} ports found in range {start}-{end}.")


def render_web_command(name: str, host: str, port: int | None, range_value: str, persistent: bool) -> str:
    parts = ["portbroker", "web", "--name", name]
    if host != DEFAULT_HOST:
        parts.extend(["--host", host])
    if port is not None:
        parts.extend(["--port", str(port)])
    if range_value != DEFAULT_RANGE:
        parts.extend(["--range", range_value])
    if persistent:
        parts.append("--persistent")
    return shlex.join(parts)


def reserve_web_port(
    *,
    name: str,
    host: str,
    requested_port: int | None,
    range_value: str,
    persistent: bool,
) -> int:
    port_range = parse_port_range(range_value)
    cmd = render_web_command(name, host, requested_port, range_value, persistent)

    with registry_lock():
        entries = load_entries(strict=True)
        existing = entries.get(name)
        now = now_iso()

        if requested_port is not None:
            for other_name, other in entries.items():
                if other_name == name:
                    continue
                if other["proto"] == "tcp" and other["port"] == requested_port:
                    raise PortBrokerError(f"Port {requested_port}/tcp is already reserved by '{other_name}'.")

            listeners = [listener for listener in listeners_for_proto("tcp") if listener.port == requested_port]
            if listeners:
                whoami = fetch_dashboard_whoami(host, requested_port)
                if whoami and whoami.get("service") == name:
                    raise PortBrokerError(f"Dashboard '{name}' is already running on {host}:{requested_port}.")
                raise PortBrokerError(
                    f"Port {requested_port}/tcp is already in use by {listener_owner_summary(listeners)}."
                )

            created_at = existing["createdAt"] if existing else now
            meta = dict(existing.get("meta", {})) if existing else {}
            entries[name] = {
                "name": name,
                "port": requested_port,
                "host": host,
                "proto": "tcp",
                "createdAt": created_at,
                "updatedAt": now,
                "cwd": os.getcwd(),
                "cmd": cmd,
                "meta": meta,
                "persistent": bool(persistent) or bool(existing and existing.get("persistent", False)),
            }
            save_registry(entries)
            return requested_port

        if existing:
            current_port = existing["port"]
            listeners = [listener for listener in listeners_for_proto("tcp") if listener.port == current_port]
            if listeners:
                whoami = fetch_dashboard_whoami(existing.get("host", host), current_port)
                if whoami and whoami.get("service") == name:
                    raise PortBrokerError(
                        f"Dashboard '{name}' is already running on {existing.get('host', host)}:{current_port}."
                    )
                selected_port = find_free_port(entries, "tcp", port_range, exclude_names={name})
            else:
                selected_port = current_port

            entries[name] = {
                "name": name,
                "port": selected_port,
                "host": host,
                "proto": "tcp",
                "createdAt": existing.get("createdAt", now),
                "updatedAt": now,
                "cwd": os.getcwd(),
                "cmd": cmd,
                "meta": dict(existing.get("meta", {})),
                "persistent": bool(persistent) or bool(existing.get("persistent", False)),
            }
            save_registry(entries)
            return selected_port

        selected_port = find_free_port(entries, "tcp", port_range)
        entries[name] = {
            "name": name,
            "port": selected_port,
            "host": host,
            "proto": "tcp",
            "createdAt": now,
            "updatedAt": now,
            "cwd": os.getcwd(),
            "cmd": cmd,
            "meta": {},
            "persistent": bool(persistent),
        }
        save_registry(entries)
        return selected_port


def dashboard_open_url(host: str, port: int) -> str:
    if host in {"0.0.0.0", "::"}:
        return f"http://<this-host>:{port}"
    if ":" in host and not host.startswith("["):
        return f"http://[{host}]:{port}"
    return f"http://{host}:{port}"


