class PortBrokerError(Exception):
    pass


@dataclass
class Listener:
    proto: str
    host: str
    port: int
    process_name: str | None
    pid: int | None
    raw: str
    source: str

    def to_dict(self) -> dict[str, Any]:
        return {
            "proto": self.proto,
            "host": self.host,
            "port": self.port,
            "process": self.process_name,
            "pid": self.pid,
            "source": self.source,
            "raw": self.raw,
        }


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def config_dir() -> Path:
    # Default registry path is ~/.config/portbroker/ports.json.
    # Optional override exists for restricted environments.
    explicit = os.environ.get("PORTBROKER_CONFIG_DIR")
    if explicit:
        return Path(explicit).expanduser()

    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg).expanduser() / "portbroker"

    return Path.home() / ".config" / "portbroker"


def registry_path() -> Path:
    explicit = os.environ.get("PORTBROKER_REGISTRY")
    if explicit:
        return Path(explicit).expanduser()
    return config_dir() / "ports.json"


def data_dir() -> Path:
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return Path(xdg).expanduser() / "portbroker"
    return Path.home() / ".local" / "share" / "portbroker"


def dashboard_path() -> Path:
    adjacent = Path(__file__).resolve().with_name("dashboard.html")
    if adjacent.exists():
        return adjacent
    return data_dir() / "dashboard.html"


def skills_dir() -> Path:
    adjacent = Path(__file__).resolve().with_name("skills")
    if adjacent.is_dir():
        return adjacent
    return data_dir() / "skills"


def lock_path() -> Path:
    explicit = os.environ.get("PORTBROKER_LOCK")
    if explicit:
        return Path(explicit).expanduser()
    return config_dir() / "ports.lock"


def ensure_parent(path: Path) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise PortBrokerError(f"Cannot create directory '{path.parent}': {exc}") from exc


@contextmanager
def registry_lock() -> Any:
    lock = lock_path()
    ensure_parent(lock)
    try:
        with open(lock, "a+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    except OSError as exc:
        raise PortBrokerError(f"Cannot open lock file '{lock}': {exc}") from exc


def load_registry_raw() -> dict[str, Any]:
    path = registry_path()
    if not path.exists():
        return {"version": 1, "entries": {}}

    try:
        content = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise PortBrokerError(f"Cannot read registry '{path}': {exc}") from exc

    if not content.strip():
        return {"version": 1, "entries": {}}

    try:
        data = json.loads(content)
    except json.JSONDecodeError as exc:
        raise PortBrokerError(
            f"Registry '{path}' is not valid JSON ({exc.msg} at line {exc.lineno}, column {exc.colno})"
        ) from exc

    if not isinstance(data, dict):
        raise PortBrokerError(f"Registry '{path}' must contain a JSON object")

    if "entries" not in data:
        # Backward-compatible read for a bare name->entry dictionary.
        if all(isinstance(value, dict) for value in data.values()):
            data = {"version": 1, "entries": data}
        else:
            raise PortBrokerError(f"Registry '{path}' is missing the 'entries' object")

    entries = data.get("entries")
    if not isinstance(entries, dict):
        raise PortBrokerError(f"Registry '{path}' field 'entries' must be a JSON object")

    return {"version": int(data.get("version", 1)), "entries": entries}


def save_registry(entries: dict[str, dict[str, Any]]) -> None:
    path = registry_path()
    ensure_parent(path)
    payload = {"version": 1, "entries": entries}

    try:
        fd, tmp_path = tempfile.mkstemp(prefix="ports.", suffix=".tmp", dir=str(path.parent))
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp_path, path)
    except OSError as exc:
        raise PortBrokerError(f"Cannot write registry '{path}': {exc}") from exc


def parse_port_range(value: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+)-(\d+)", value)
    if not match:
        raise PortBrokerError(f"Invalid range '{value}'. Expected format START-END (e.g., 8700-8999).")
    start = int(match.group(1))
    end = int(match.group(2))
    if start < 1 or end > 65535 or start > end:
        raise PortBrokerError(f"Invalid range '{value}'. Ports must be between 1 and 65535 and START <= END.")
    return start, end


def parse_port(value: Any) -> int:
    try:
        port = int(value)
    except (TypeError, ValueError) as exc:
        raise PortBrokerError(f"Invalid port '{value}'.") from exc
    if port < 1 or port > 65535:
        raise PortBrokerError(f"Invalid port '{value}'. Port must be between 1 and 65535.")
    return port


def flatten_meta(meta_values: list[list[str]] | None) -> list[str]:
    if not meta_values:
        return []
    flattened: list[str] = []
    for chunk in meta_values:
        flattened.extend(chunk)
    return flattened


def parse_meta(meta_values: list[list[str]] | None) -> dict[str, str]:
    result: dict[str, str] = {}
    for item in flatten_meta(meta_values):
        if "=" not in item:
            raise PortBrokerError(f"Invalid --meta value '{item}'. Expected key=value.")
        key, value = item.split("=", 1)
        key = key.strip()
        if not key:
            raise PortBrokerError(f"Invalid --meta value '{item}'. Meta keys cannot be empty.")
        result[key] = value
    return result


def parse_bool(value: Any, *, default: bool = False) -> bool:
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        if value in {0, 1}:
            return bool(value)
        raise ValueError
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "y", "on"}:
            return True
        if normalized in {"0", "false", "no", "n", "off", ""}:
            return False
        raise ValueError
    raise ValueError


def parse_endpoint(endpoint: str) -> tuple[str, int] | None:
    value = endpoint.strip()
    if not value:
        return None

    if value.startswith("["):
        idx = value.rfind("]:")
        if idx < 0:
            return None
        host = value[1:idx]
        port_text = value[idx + 2 :]
    else:
        if ":" not in value:
            return None
        host, port_text = value.rsplit(":", 1)

    if not port_text.isdigit():
        return None

    return host, int(port_text)


def parse_ss_processes(field: str) -> list[tuple[str | None, int | None]]:
    if not field:
        return []

    matches = list(re.finditer(r'"([^"]+)"(?:,pid=(\d+))?', field))
    processes: list[tuple[str | None, int | None]] = []
    for match in matches:
        process = match.group(1)
        pid_text = match.group(2)
        pid = int(pid_text) if pid_text else None
        processes.append((process, pid))
    return processes


def listeners_from_ss(proto: str) -> list[Listener]:
    cmd = ["ss", "-H", "-l", "-n", "-p", "-t" if proto == "tcp" else "-u"]
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)

    if proc.returncode != 0 and not proc.stdout.strip():
        detail = proc.stderr.strip() or f"exit code {proc.returncode}"
        raise PortBrokerError(f"`ss` failed: {detail}")

    listeners: list[Listener] = []
    for raw_line in proc.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        parts = line.split(None, 5)
        if len(parts) < 5:
            continue
        endpoint = parse_endpoint(parts[3])
        if endpoint is None:
            continue
        host, port = endpoint
        process_field = parts[5] if len(parts) >= 6 else ""
        processes = parse_ss_processes(process_field)
        if processes:
            for process_name, pid in processes:
                listeners.append(
                    Listener(
                        proto=proto,
                        host=host,
                        port=port,
                        process_name=process_name,
                        pid=pid,
                        raw=line,
                        source="ss",
                    )
                )
        else:
            listeners.append(
                Listener(
                    proto=proto,
                    host=host,
                    port=port,
                    process_name=None,
                    pid=None,
                    raw=line,
                    source="ss",
                )
            )
    return listeners


def listeners_from_lsof_tcp() -> list[Listener]:
    cmd = ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"]
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)

    if proc.returncode not in {0, 1}:
        detail = proc.stderr.strip() or f"exit code {proc.returncode}"
        raise PortBrokerError(f"`lsof` failed: {detail}")

    listeners: list[Listener] = []
    lines = proc.stdout.splitlines()
    for line in lines[1:]:
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        command = parts[0]
        pid_text = parts[1]
        pid = int(pid_text) if pid_text.isdigit() else None
        name_field = parts[8]
        match = re.search(r"(.+):(\d+)\s+\(LISTEN\)$", name_field)
        if not match:
            continue
        host = match.group(1)
        if host.startswith("[") and host.endswith("]"):
            host = host[1:-1]
        port = int(match.group(2))
        listeners.append(
            Listener(
                proto="tcp",
                host=host,
                port=port,
                process_name=command,
                pid=pid,
                raw=line,
                source="lsof",
            )
        )
    return listeners


def listeners_for_proto(proto: str) -> list[Listener]:
    if proto not in SUPPORTED_PROTOS:
        raise PortBrokerError(f"Unsupported protocol '{proto}'. Expected one of: {', '.join(sorted(SUPPORTED_PROTOS))}.")

    ss_path = shutil.which("ss")
    if ss_path:
        try:
            return listeners_from_ss(proto)
        except PortBrokerError:
            if proto == "tcp" and shutil.which("lsof"):
                return listeners_from_lsof_tcp()
            raise

    if proto == "tcp" and shutil.which("lsof"):
        return listeners_from_lsof_tcp()

    if proto == "tcp":
        raise PortBrokerError(
            "Cannot inspect port usage: `ss` is unavailable and fallback `lsof -iTCP -sTCP:LISTEN` is unavailable."
        )
    raise PortBrokerError("Cannot inspect UDP listeners without `ss`.")


def listeners_by_key(entries: dict[str, dict[str, Any]]) -> dict[tuple[str, int], list[Listener]]:
    mapping: dict[tuple[str, int], list[Listener]] = {}
    protos = sorted({entry["proto"] for entry in entries.values() if "proto" in entry})
    for proto in protos:
        for listener in listeners_for_proto(proto):
            mapping.setdefault((listener.proto, listener.port), []).append(listener)
    return mapping


def normalize_entries(raw_entries: Any) -> tuple[dict[str, dict[str, Any]], list[dict[str, str]]]:
    issues: list[dict[str, str]] = []
    normalized: dict[str, dict[str, Any]] = {}

    if not isinstance(raw_entries, dict):
        issues.append({"level": "error", "name": "-", "message": "Registry 'entries' is not an object."})
        return normalized, issues

    seen_proto_port: dict[tuple[str, int], str] = {}

    for key, value in raw_entries.items():
        name = str(key)
        if not isinstance(value, dict):
            issues.append({"level": "error", "name": name, "message": "Entry must be an object."})
            continue

        entry_name = str(value.get("name", key))
        if entry_name != name:
            issues.append(
                {
                    "level": "warning",
                    "name": name,
                    "message": f"Entry name field '{entry_name}' does not match key '{name}'.",
                }
            )

        try:
            port = parse_port(value.get("port"))
        except PortBrokerError as exc:
            issues.append({"level": "error", "name": name, "message": str(exc)})
            continue

        host = str(value.get("host", DEFAULT_HOST))
        proto = str(value.get("proto", DEFAULT_PROTO)).lower()
        if proto not in SUPPORTED_PROTOS:
            issues.append(
                {
                    "level": "error",
                    "name": name,
                    "message": f"Unsupported proto '{proto}'. Expected tcp or udp.",
                }
            )
            continue

        created_at = str(value.get("createdAt", ""))
        updated_at = str(value.get("updatedAt", ""))
        cwd = str(value.get("cwd", ""))
        cmd = value.get("cmd", "")
        if cmd is None:
            cmd = ""
        if not isinstance(cmd, str):
            cmd = str(cmd)
        meta = value.get("meta", {})
        if not isinstance(meta, dict):
            issues.append({"level": "warning", "name": name, "message": "Meta is not an object; resetting to {}."})
            meta = {}
        try:
            persistent = parse_bool(value.get("persistent", False), default=False)
        except ValueError:
            issues.append(
                {"level": "warning", "name": name, "message": "Persistent is invalid; resetting to false."}
            )
            persistent = False

        dedupe_key = (proto, port)
        prior = seen_proto_port.get(dedupe_key)
        if prior and prior != name:
            issues.append(
                {
                    "level": "error",
                    "name": name,
                    "message": f"Duplicate reservation for {proto}/{port}. Already reserved by '{prior}'.",
                }
            )
            continue
        seen_proto_port[dedupe_key] = name

        normalized[name] = {
            "name": name,
            "port": port,
            "host": host,
            "proto": proto,
            "createdAt": created_at,
            "updatedAt": updated_at,
            "cwd": cwd,
            "cmd": cmd,
            "meta": meta,
            "persistent": persistent,
        }

    return normalized, issues


def load_entries(strict: bool = True) -> dict[str, dict[str, Any]]:
    raw = load_registry_raw()
    normalized, issues = normalize_entries(raw.get("entries", {}))
    if strict and any(issue["level"] == "error" for issue in issues):
        first = next(issue for issue in issues if issue["level"] == "error")
        raise PortBrokerError(
            f"Registry has invalid entries ({first['name']}: {first['message']}). "
            "Run `portbroker doctor` for details."
        )
    return normalized


def load_entries_with_issues() -> tuple[dict[str, dict[str, Any]], list[dict[str, str]]]:
    raw = load_registry_raw()
    return normalize_entries(raw.get("entries", {}))


def emit_port(name: str, port: int, as_json: bool) -> None:
