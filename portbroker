const refreshMs = {DASHBOARD_REFRESH_MS};
// Safe default for local access; browser hostname can override this automatically.
const fallbackLanHost = '127.0.0.1';
const rowsNode = document.getElementById('rows');
const warningNode = document.getElementById('warning');

function setText(id, value) {{
  document.getElementById(id).textContent = String(value);
}}

function appendCell(row, value, className) {{
  const cell = document.createElement('td');
  if (className) {{
    cell.className = className;
  }}
  cell.textContent = value;
  row.appendChild(cell);
}}

function isWildcardOrLoopback(host) {{
  const value = String(host || '').trim().toLowerCase();
  return (
    !value ||
    value === '0.0.0.0' ||
    value === '::' ||
    value === '*' ||
    value === 'localhost' ||
    value === '127.0.0.1' ||
    value === '::1'
  );
}}

function normalizedHost(host) {{
  const browserHost = String(window.location.hostname || '').trim();
  if (isWildcardOrLoopback(host)) {{
    return browserHost || fallbackLanHost;
  }}
  return String(host || '').trim();
}}

function httpUrl(host, port) {{
  const formattedHost = host.includes(':') && !host.startsWith('[') && !host.endsWith(']')
    ? `[${{host}}]`
    : host;
  return `http://${{formattedHost}}:${{port}}`;
}}

function appendNameCell(row, item) {{
  const cell = document.createElement('td');
  cell.className = 'site-name';
  const name = item.name || '';
  const port = Number(item.port);
  const isTcp = String(item.proto || '').toLowerCase() === 'tcp';
  if (!isTcp || !Number.isInteger(port) || port < 1 || port > 65535) {{
    cell.textContent = name;
    row.appendChild(cell);
    return;
  }}

  const primaryHost = normalizedHost(item.host);
  const primaryLink = document.createElement('a');
  primaryLink.className = 'site-link';
  primaryLink.href = httpUrl(primaryHost, port);
  primaryLink.textContent = name || `${{primaryHost}}:${{port}}`;
  cell.appendChild(primaryLink);

  if (primaryHost !== fallbackLanHost) {{
    const fallback = document.createElement('div');
    fallback.className = 'site-fallback';
    fallback.appendChild(document.createTextNode('fallback '));
    const fallbackLink = document.createElement('a');
    fallbackLink.href = httpUrl(fallbackLanHost, port);
    fallbackLink.textContent = `${{fallbackLanHost}}:${{port}}`;
    fallback.appendChild(fallbackLink);
    cell.appendChild(fallback);
  }}

  row.appendChild(cell);
}}

function appendStatus(row, status) {{
  const cell = document.createElement('td');
  const pill = document.createElement('span');
  pill.className = `pill ${{status}}`;
  if (status === 'active') {{
    pill.textContent = 'Active';
  }} else if (status === 'reserved') {{
    pill.textContent = 'Reserved';
  }} else {{
    pill.textContent = 'Unknown';
  }}
  cell.appendChild(pill);
  row.appendChild(cell);
}}

function renderRows(items) {{
  rowsNode.textContent = '';
  if (!items.length) {{
    const row = document.createElement('tr');
    const cell = document.createElement('td');
    cell.colSpan = 8;
    cell.textContent = 'No reservations in the registry.';
    row.appendChild(cell);
    rowsNode.appendChild(row);
    return;
  }}

  for (const item of items) {{
    const row = document.createElement('tr');
    const tooltip = [];
    if (item.cwd) {{
      tooltip.push(`cwd: ${{item.cwd}}`);
    }}
    if (item.cmd) {{
      tooltip.push(`cmd: ${{item.cmd}}`);
    }}
    const metaEntries = Object.entries(item.meta || {{}});
    if (metaEntries.length) {{
      tooltip.push('meta: ' + metaEntries.map(([key, value]) => key + '=' + value).join(', '));
    }}
    if (tooltip.length) {{
      row.title = tooltip.join('\\n');
    }}

    appendNameCell(row, item);
    appendCell(row, String(item.port ?? ''), 'mono');
    appendCell(row, normalizedHost(item.host), 'mono');
    appendCell(row, item.proto || '', 'mono');
    appendStatus(row, item.status || 'unknown');

    const processes = Array.isArray(item.listeners) && item.listeners.length ? item.listeners.join(', ') : 'idle';
    appendCell(row, processes, 'mono process');
    appendCell(row, item.persistent ? 'yes' : 'no');
    appendCell(row, item.updatedAt || item.createdAt || '', 'mono');
    rowsNode.appendChild(row);
  }}
}}

async function refresh() {{
  try {{
    const response = await fetch('/api/ports', {{ cache: 'no-store' }});
    const data = await response.json();
    if (!response.ok) {{
      throw new Error(data.error || `HTTP ${{response.status}}`);
    }}

    setText('totalCount', data.summary?.total ?? 0);
    setText('activeCount', data.summary?.active ?? 0);
    setText('reservedCount', data.summary?.reserved ?? 0);
    setText('persistentCount', data.summary?.persistent ?? 0);

    const checkedAt = data.checkedAt ? `Last checked ${{data.checkedAt}}` : 'Waiting for first refresh...';
    const registry = data.registryPath ? ` • Registry ${{data.registryPath}}` : '';
    setText('checkedAt', `${{checkedAt}}${{registry}}`);

    warningNode.hidden = !data.listenerError;
    warningNode.textContent = data.listenerError || '';
    renderRows(data.ports || []);
  }} catch (error) {{
    warningNode.hidden = false;
    warningNode.textContent = `Refresh failed: ${{error.message}}`;
  }}
}}

refresh();
window.setInterval(refresh, refreshMs);
</script>
